+/* The plain-text flavour of the clipboard is what a rendered page decides to
+   give you, and some pages give you every line flush left with no bullets at
+   all, which leaves nothing to recover the structure from. The text/html
+   flavour of the same copy still carries the real <ul>/<li> nesting, so read
+   that when it is there and only fall back to the text. */
+function parseOutlineHtml(html){
+  var doc=null;
+  try{ doc=new DOMParser().parseFromString(html,"text/html"); }catch(e){ return null; }
+  if(!doc||!doc.body) return null;
+  var items=[];
+  function textOf(el){
+    var c=el.cloneNode(true);
+    /* Drop nested lists first, or a parent item swallows everything under it. */
+    Array.prototype.forEach.call(c.querySelectorAll("ul,ol"),function(x){
+      if(x.parentNode) x.parentNode.removeChild(x);
+    });
+    return (c.textContent||"").replace(/\u00a0/g," ").replace(/\s+/g," ").trim();
+  }
+  function walk(el,depth){
+    Array.prototype.forEach.call(el.children,function(ch){
+      var tag=(ch.tagName||"").toLowerCase();
+      if(tag==="ul"||tag==="ol"){ walk(ch,depth+1); return; }
+      if(tag==="li"){
+        var t=textOf(ch);
+        if(t) items.push({indent:depth*10,text:t});
+        Array.prototype.forEach.call(ch.children,function(k){
+          var kt=(k.tagName||"").toLowerCase();
+          if(kt==="ul"||kt==="ol") walk(k,depth+1);
+        });
+        return;
+      }
+      var h=tag.match(/^h([1-6])$/);
+      if(h){ var ht=textOf(ch); if(ht) items.push({indent:(+h[1]-1)*10,text:ht}); return; }
+      if(tag==="p"||tag==="div"){
+        /* A paragraph that only wraps a list is scaffolding, not an item. */
+        if(!ch.querySelector("ul,ol")){
+          var pt=textOf(ch);
+          if(pt) items.push({indent:depth*10,text:pt});
+          return;
+        }
+      }
+      walk(ch,depth);
+    });
+  }
+  walk(doc.body,0);
+  return items.length?items:null;
+}
+/* Whichever flavour recovered more structure wins. A copy with real nesting in
+   its html beats flattened text; a plain-text copy with no html beats nothing. */
+function levelCount(items){
+  var m={}; (items||[]).forEach(function(x){ m[x.indent]=1; });
+  return Object.keys(m).length;
+}
+function bestOutline(html,text){
+  var t=parseOutline(text||"");
+  var h=(html&&/<li|<ul|<ol/i.test(html))?parseOutlineHtml(html):null;
+  if(h && h.length>1 && levelCount(h)>levelCount(t)) return h;
+  return t;
+}
